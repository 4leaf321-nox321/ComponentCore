# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
# 비우면 postgresql+psycopg://postgres:postgres@localhost:5432/autojig (DB 이름은 APP_SLUG 에서)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/autojig
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me
# 화면 이름을 바꾸고 싶으면(선택). 기본은 AutoJigGenerator / autojig.
# APP_NAME=
# APP_SLUG=

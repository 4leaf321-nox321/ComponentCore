# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
# 비우면 postgresql+psycopg://postgres:postgres@localhost:5432/compcore (DB 이름은 APP_SLUG 에서)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/compcore
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me
# 화면 이름을 바꾸고 싶으면(선택). 기본은 CompCore / compcore.
# APP_NAME=
# APP_SLUG=
# 실험계획(DOE). 공유 폴더는 해석(ANSYS)이 읽는 곳, 상한은 한 번에 만드는 설계점 수(기본 200).
# DOE_EXPORT_ROOT=/mnt/f/data/0_Program/73_AutoJigGenerator
# DOE_MAX_POINTS=200
# DOE_MAX_SAMPLES=500
# 화면이 쓰는 수 — 실험계획 형상 보기에서 한 번에 그리는 수, 목록 한 쪽의 줄 수.
# 넷 다 관리자가 화면(서버 › 설정)에서 바꾼다 — 여기 값은 그 기본값일 뿐이다.
# DOE_GALLERY_MAX=24
# LIST_PAGE_SIZE=20
# 물성 플랫폼(MatNexus). **서버가 대신 부르는 자격**이라 사람마다 넣지 않는다.
# 그 PAT 에는 범위가 없어서 우리는 늘 전역 재료만 묻는다(scope=global 을 코드가 박는다).
# 비우면 물성 탐색기는 관리자가 올려 둔 카탈로그 파일로만 돈다.
# MATNEXUS_BASE_URL=http://10.252.39.120:8010
# MATNEXUS_TOKEN=mnx_pat_...
# AI 도구가 붙는 MCP 주소. 비우면 접속 호스트 + (포트 + 2). 프록시 뒤에서는 공개 주소를 준다.
# MCP_PUBLIC_URL=

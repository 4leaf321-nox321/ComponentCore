# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
# 비우면 postgresql+psycopg://postgres:postgres@localhost:5432/compcore (DB 이름은 APP_SLUG 에서)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/compcore
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me
# 화면 이름을 바꾸고 싶으면(선택). 기본은 CompCore / compcore.
# APP_NAME=
# APP_SLUG=
# 실험계획(DOE). 공유 폴더는 해석(ANSYS)이 읽는 곳, 상한은 한 번에 만드는 설계점 수(기본 200).
# DOE_EXPORT_ROOT=/mnt/f/data/0_Program/73_AutoJigGenerator
# DOE_MAX_POINTS=200
# DOE_MAX_SAMPLES=500
# 설계점 파일을 며칠 두나. 공유 폴더는 전달 큐라 짧고(30일), 서버 보관 폴더는 보관소라 길다
# (180일). 지나도 **파일만** 지운다 — 스터디 · 레시피 스냅샷은 남고 「다시 만들기」 가 되살린다.
# 0 이면 안 지운다. 스터디마다 「영구보관」 을 켜면 둘 다 기한과 무관하게 남는다.
# DOE_EXPORT_TTL_DAYS=30
# DOE_LOCAL_TTL_DAYS=180
# 화면이 쓰는 수 — 실험계획 형상 보기에서 한 번에 그리는 수, 목록 한 쪽의 줄 수.
# 넷 다 관리자가 화면(서버 › 설정)에서 바꾼다 — 여기 값은 그 기본값일 뿐이다.
# DOE_GALLERY_MAX=24
# LIST_PAGE_SIZE=20
# 물성 플랫폼(MatNexus) — 물성 탐색기가 재료를 가져오는 곳.
#
# **서버가 대신 부르는 자격**이라 사람마다 넣지 않는다.
#
# **무엇이 보이나는 그쪽이 정한다**(2026-09-24 권한 개편). MatNexus 는 부서 트리로 권한을
# 나누고 PAT 에는 범위가 없다 — 그래서 경계는 「이 토큰이 누구냐」 하나다. 시스템 관리자
# 토큰을 넣으면 전부 보이므로, **읽기 전용 계정**을 만들어 필요한 부서에만 넣는 것이 맞다.
# 확인: `.venv/bin/python scripts/check_matnexus.py` 가 누구로 붙었는지 말해 준다.
#
# **개발 PC 의 MatNexus 는 8011 이다**(8010 은 운영 기본값). 서버가 WSL 이면 윈도우 쪽 주소는
# 기본 게이트웨이다 — `ip route | grep default` 의 세 번째 값. **WSL 을 다시 켜면 바뀐다.**
MATNEXUS_BASE_URL=http://172.25.208.1:8011
# 토큰은 MatNexus 화면의 「내 정보 → 토큰」 에서 발급한다. 비우면 탐색기는 관리자가 올려 둔
# 카탈로그 파일로만 돈다(폐쇄망 · 점검 때의 길).
MATNEXUS_TOKEN=
# 부서(workspace slug)로 좁히기 — 비우면 그 계정이 보는 전부. **권한이 아니라 좁히기다**:
# 토큰이 볼 수 있는 것보다 넓힐 수는 없다. 부서가 여럿인 계정으로 붙었는데 물성 탐색기에
# 남의 부서 재료까지 쏟아질 때 쓴다. 예: default · polymer
# MATNEXUS_WORKSPACE=
# AI 도구가 붙는 MCP 주소. 비우면 접속 호스트 + (포트 + 2). 프록시 뒤에서는 공개 주소를 준다.
# MCP_PUBLIC_URL=

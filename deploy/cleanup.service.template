[Unit]
Description=@@APP_NAME@@ 실험계획 폴더 청소 (기한 지난 설계점 파일)

[Service]
Type=oneshot
User=@@USER@@
Group=@@USER@@
WorkingDirectory=@@INSTALL_DIR@@

# **파일만 지운다.** 스터디 · 설계점 · 레시피 스냅샷은 DB 에 남으므로 화면은 그대로 뜨고,
# 「다시 만들기」 가 같은 파일을 되살린다. 지우는 대상은 영구보관이 아니고 기한이 지난 것뿐이다.
#
# 웹·워커와 **같은 SIF·같은 .env** 로 돈다. 두 폴더를 다 만지므로 둘 다 bind 한다
# (서버 보관 폴더는 filestore 안에 있다).
#
# 이중화에서 두 서버에 다 걸려도 된다 — 지울 것이 없으면 아무 일도 안 한다(멱등).
ExecStart=/usr/bin/apptainer exec \
    --bind @@ENV_FILE@@:/opt/app/backend/.env:ro \
    --bind @@FILESTORE_DIR@@:/data/filestore \
    --bind @@LOG_DIR@@:/data/logs \
@@DOE_BIND@@
    @@INSTALL_DIR@@/app.sif \
    sh -c 'cd /opt/app/backend && /opt/app/venv/bin/python scripts/cleanup_doe_exports.py'

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true
